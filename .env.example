DATABASE_URL=postgres://memoryscape:memoryscape_local@127.0.0.1:5432/memoryscape
POSTGRES_DB=memoryscape
POSTGRES_USER=memoryscape
POSTGRES_PASSWORD=memoryscape_local
ALLOW_MANUAL_MAINTENANCE=true
# Optional single-user app login. Set both before exposing MemoryScape beyond localhost.
# Generate the session secret with: openssl rand -hex 32
MEMORYSCAPE_PASSWORD=
MEMORYSCAPE_SESSION_SECRET=
